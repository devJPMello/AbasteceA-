# Copy to .env (root) and apps/api/.env
POSTGRES_USER=bomba
POSTGRES_PASSWORD=bomba
POSTGRES_DB=bomba_certa
POSTGRES_PORT=5440
REDIS_PORT=6379

DATABASE_URL=postgresql://bomba:bomba@localhost:5440/bomba_certa?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-to-a-random-string-of-32+-chars
# Optional (defaults in apps/api/src/config/env.ts):
# PORT=3000
# PRICE_PLAUSIBILITY_PCT=15
# CORS_ORIGIN=http://localhost:5173

# Jobs (optional)
# ANP_IMPORT_ENABLED=true
# ANP_DATASET_URL=https://...   # weekly ANP stations CSV (verify the current link on gov.br/anp)
# ANP_MATCH_RADIUS_METERS=200  # radius to match ANP stations to existing (OSM) ones
# SMTP_URL=smtp://localhost:1026
