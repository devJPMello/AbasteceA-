generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

enum FuelType {
  GASOLINE_COMMON
  GASOLINE_PREMIUM
  ETHANOL
  DIESEL_S10

  @@map("fuel_type")
}

/// Origin of a record: reported by an app user or imported from ANP open data.
enum PriceSource {
  USER
  ANP

  @@map("price_source")
}

/// Where a station record came from. Kept apart from PriceSource (the origin of a PRICE).
enum StationSource {
  USER
  ANP
  OSM

  @@map("station_source")
}

enum ReportStatus {
  PENDING
  ACTIVE
  REJECTED

  @@map("report_status")
}

model User {
  id            String               @id @default(uuid()) @db.Uuid
  email         String               @unique
  name          String
  passwordHash  String               @map("password_hash")
  createdAt     DateTime             @default(now()) @map("created_at")
  refreshTokens RefreshToken[]
  reports       PriceReport[]
  confirmations ReportConfirmation[]
  alerts        PriceAlert[]
  notifications Notification[]
  deviceTokens  DeviceToken[]

  @@map("users")
}

/// Refresh tokens are stored hashed, rotated on use; `familyId` enables reuse detection
/// (a revoked token being presented again revokes the whole family).
model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, familyId])
  @@map("refresh_tokens")
}

model Station {
  id            String                @id @default(uuid()) @db.Uuid
  name          String
  brand         String
  /// Natural key used to match ANP rows to existing stations.
  cnpj          String?               @unique
  address       String
  city          String                @default("Palmas")
  /// WGS84 point. Queried with raw SQL (ST_DWithin / ST_Distance); Prisma cannot read it.
  location      Unsupported("geography(Point,4326)")
  source        StationSource         @default(USER)
  createdAt     DateTime              @default(now()) @map("created_at")
  reports       PriceReport[]
  currentPrices StationCurrentPrice[]

  @@index([location], type: Gist)
  @@map("stations")
}

model PriceReport {
  id                 String               @id @default(uuid()) @db.Uuid
  stationId          String               @map("station_id") @db.Uuid
  /// Null when source = ANP.
  userId             String?              @map("user_id") @db.Uuid
  fuelType           FuelType             @map("fuel_type")
  /// Thousandths of BRL: R$ 5,899 => 5899. Integer to avoid float rounding.
  priceMilli         Int                  @map("price_milli")
  source             PriceSource
  status             ReportStatus
  confirmationsCount Int                  @default(0) @map("confirmations_count")
  reportedAt         DateTime             @default(now()) @map("reported_at")
  station            Station              @relation(fields: [stationId], references: [id], onDelete: Cascade)
  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  confirmations      ReportConfirmation[]

  @@index([stationId, fuelType, reportedAt(sort: Desc)])
  // Supports the "one report per user/station/fuel every 6h" check.
  @@index([userId, stationId, fuelType, reportedAt(sort: Desc)])
  @@map("price_reports")
}

model ReportConfirmation {
  reportId  String      @map("report_id") @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  createdAt DateTime    @default(now()) @map("created_at")
  report    PriceReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([reportId, userId])
  @@map("report_confirmations")
}

/// Denormalized "current price" per station and fuel, maintained on write.
/// Lets radius searches sort by price without a DISTINCT ON over the full history.
model StationCurrentPrice {
  stationId  String      @map("station_id") @db.Uuid
  fuelType   FuelType    @map("fuel_type")
  priceMilli Int         @map("price_milli")
  source     PriceSource
  reportId   String      @map("report_id") @db.Uuid
  reportedAt DateTime    @map("reported_at")
  station    Station     @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@id([stationId, fuelType])
  @@index([fuelType, priceMilli])
  @@map("station_current_prices")
}

model PriceAlert {
  id               String                               @id @default(uuid()) @db.Uuid
  userId           String                               @map("user_id") @db.Uuid
  fuelType         FuelType                             @map("fuel_type")
  targetPriceMilli Int                                  @map("target_price_milli")
  radiusMeters     Int                                  @map("radius_meters")
  center           Unsupported("geography(Point,4326)")
  active           Boolean                              @default(true)
  /// Dedupe: set when notified, cleared when the price rises above the target again.
  lastNotifiedAt   DateTime?                            @map("last_notified_at")
  createdAt        DateTime                             @default(now()) @map("created_at")
  user             User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([center], type: Gist)
  @@index([userId])
  @@map("price_alerts")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  title     String
  body      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

/// Audit trail of the weekly ANP import job.
model AnpImportRun {
  id           String    @id @default(uuid()) @db.Uuid
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  rowsRead     Int       @default(0) @map("rows_read")
  rowsImported Int       @default(0) @map("rows_imported")
  rowsSkipped  Int       @default(0) @map("rows_skipped")
  status       String
  error        String?

  @@map("anp_import_runs")
}

/// Expo push tokens of a user's devices. The token is unique: if a phone is handed to another
/// account it simply moves to the new owner.
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique
  platform  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
