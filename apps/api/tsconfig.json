{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "outDir": "./dist",
    "rootDir": ".",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "isolatedModules": false,
    "sourceMap": true,
    "incremental": true,
    "types": ["node", "jest"]
  },
  "include": ["src", "test", "prisma/seed.ts"]
}
