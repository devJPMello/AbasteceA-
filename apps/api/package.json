{
  "name": "@bomba-certa/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @bomba-certa/shared build && jest",
    "test:e2e": "pnpm --filter @bomba-certa/shared build && jest --config test/jest-e2e.config.js --runInBand",
    "seed": "tsx prisma/seed.ts",
    "anp:import": "nest build && node scripts/anp-import.js",
    "osm:fetch": "tsx scripts/fetch-osm-stations.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate"
  },
  "dependencies": {
    "@bomba-certa/shared": "workspace:*",
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^11.2.11",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.11",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.11",
    "@nestjs/swagger": "^11.4.8",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.6",
    "csv-parse": "^7.0.3",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.2",
    "nestjs-zod": "^5.6.0",
    "nodemailer": "^10.6.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.11",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "files": [
    "dist",
    "prisma"
  ]
}
