# Cloudflare Pages headers. The service worker and the files that decide which version is live
# must never be cached by the browser, or users could be stuck on an old release.
/sw.js
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
# Hashed build output is immutable.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
